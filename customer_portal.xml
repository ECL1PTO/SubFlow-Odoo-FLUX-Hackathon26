
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_subscription_list" name="My Subscriptions">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2>My Subscriptions</h2>

                <div class="card p-3 mb-4">
                    <h5>Total Subscriptions</h5>
                    <h3 t-esc="subscription_count"/>
                </div>

                <t t-if="subscriptions">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Plan</th>
                                <th>Start Date</th>
                                <th>Expiry Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="subscriptions" t-as="sub">
                                <tr>
                                    <td>
                                        <a t-att-href="'/my/subscriptions/%s' % sub.id">
                                            <span t-esc="sub.name"/>
                                        </a>
                                    </td>
                                    <td t-esc="sub.plan_id.display_name"/>
                                    <td t-esc="sub.start_date"/>
                                    <td t-esc="sub.expiry_date"/>
                                    <td t-esc="sub.state"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <t t-else="">
                    <p>No subscriptions found.</p>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_subscription_detail" name="Subscription Details">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h2>Subscription Details</h2>

                <div class="card p-4">
                    <p>Reference: <span t-esc="subscription.name"/></p>
                    <p>Plan: <span t-esc="subscription.plan_id.display_name"/></p>
                    <p>Start Date: <span t-esc="subscription.start_date"/></p>
                    <p>Expiry Date: <span t-esc="subscription.expiry_date"/></p>
                    <p>Status: <span t-esc="subscription.state"/></p>
                    <p>Total: <span t-esc="subscription.amount_total"/></p>
                </div>

                <a href="/my/subscriptions" class="btn btn-secondary mt-3">
                    Back to Subscriptions
                </a>
            </div>
        </t>
    </template>

</odoo>
