<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_subscription" model="ir.module.category">
            <field name="name">Subscription Management</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_subscription_staff" model="res.groups">
            <field name="name">Staff</field>
            <field name="category_id" ref="module_category_subscription"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Day-to-day handling of customers and subscriptions, without configuration rights.</field>
        </record>

        <record id="group_subscription_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_subscription"/>
            <field name="implied_ids" eval="[(4, ref('group_subscription_staff'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full control over plans, discounts, taxes and staff accounts.</field>
        </record>

        <record id="subscription_rule_company" model="ir.rule">
            <field name="name">Subscription: multi-company</field>
            <field name="model_id" ref="model_subscription_subscription"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="subscription_rule_staff" model="ir.rule">
            <field name="name">Subscription: staff see all</field>
            <field name="model_id" ref="model_subscription_subscription"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_subscription_staff'))]"/>
        </record>

        <record id="subscription_rule_portal" model="ir.rule">
            <field name="name">Subscription: portal customers see only their own</field>
            <field name="model_id" ref="model_subscription_subscription"/>
            <field name="domain_force">[('partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="subscription_line_rule_portal" model="ir.rule">
            <field name="name">Subscription line: portal customers see only their own</field>
            <field name="model_id" ref="model_subscription_line"/>
            <field name="domain_force">[('subscription_id.partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
