<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="subscription_view_search" model="ir.ui.view">
        <field name="name">subscription.subscription.search</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <search string="Subscriptions">
                <field name="name" string="Reference"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_quotation" string="Quotation" domain="[('state', '=', 'quotation')]"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_paused" string="Paused" domain="[('state', '=', 'paused')]"/>
                <filter name="filter_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_expiring" string="Expiring This Month"
                        domain="[('expiry_date', '&lt;=', (context_today() + relativedelta(months=1)).strftime('%Y-%m-%d')),
                                 ('expiry_date', '!=', False),
                                 ('state', 'in', ('confirmed', 'active', 'paused'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_start_date" string="Start Date" context="{'group_by': 'start_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="subscription_view_list" model="ir.ui.view">
        <field name="name">subscription.subscription.list</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'paused'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'paused'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="subscription_view_form" model="ir.ui.view">
        <field name="name">subscription.subscription.form</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_send_quotation" string="Send Quotation" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'quotation'"/>
                    <button name="action_start" string="Start" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_resume" string="Resume" type="object"
                            class="btn-primary" invisible="state != 'paused'"/>
                    <button name="action_pause" string="Pause" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state not in ('confirmed', 'active', 'paused')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('quotation', 'closed')"/>
                    <button name="generate_invoice" string="Generate Invoice" type="object"
                            invisible="state not in ('active', 'paused')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,quotation,confirmed,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Quotation Expired" bg_color="text-bg-danger"
                            invisible="not is_quotation_expired"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state not in ('draft', 'quotation')"/>
                            <field name="plan_id" readonly="state not in ('draft', 'quotation')"/>
                            <field name="payment_term_id"/>
                        </group>
                        <group>
                            <field name="start_date" readonly="state not in ('draft', 'quotation')"/>
                            <field name="expiry_date"/>
                            <field name="validity_date" invisible="state != 'quotation'"/>
                            <field name="is_quotation_expired" invisible="1"/>
                            <field name="next_invoice_date" readonly="1"
                                   invisible="state not in ('active', 'paused')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subscription Lines" name="lines">
                            <field name="line_ids" readonly="state in ('closed',)">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="price_subtotal"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="subscription_action" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">subscription.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="subscription_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription
            </p>
            <p>
                Track a customer's plan, lines and billing dates from draft through to closure.
            </p>
        </field>
    </record>

</odoo>
