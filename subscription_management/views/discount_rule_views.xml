<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_discount_rule_list" model="ir.ui.view">
        <field name="name">discount.rule.list</field>
        <field name="model">discount.rule</field>
        <field name="arch" type="xml">
            <list string="Discount Rules">
                <field name="name"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="apply_on"/>
                <field name="min_purchase_amount"/>
                <field name="min_quantity"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="current_usage"/>
                <field name="usage_limit"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_discount_rule_form" model="ir.ui.view">
        <field name="name">discount.rule.form</field>
        <field name="model">discount.rule</field>
        <field name="arch" type="xml">
            <form string="Discount Rule">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Multi-Seat 10% Discount"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Discount Details">
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="apply_on"/>
                            <field name="product_ids" widget="many2many_tags" invisible="apply_on != 'product'" required="apply_on == 'product'"/>
                            <field name="active"/>
                        </group>
                        <group string="Conditions &amp; Usage Limits">
                            <field name="min_purchase_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="min_quantity"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="usage_limit"/>
                            <field name="current_usage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_discount_rule" model="ir.actions.act_window">
        <field name="name">Discount Rules</field>
        <field name="res_model">discount.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>