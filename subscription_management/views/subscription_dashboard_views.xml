<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_subscription_dashboard_form" model="ir.ui.view">
        <field name="name">subscription.dashboard.form</field>
        <field name="model">subscription.dashboard</field>
        <field name="arch" type="xml">
            <form string="Subscription Dashboard" create="false" edit="false">
                <header>
                    <button name="action_refresh" string="Refresh" type="object" class="btn-primary"/>
                </header>
                <sheet class="o_subscription_dashboard">
                    <div class="oe_title mb-1">
                        <h1>Subscription Overview</h1>
                        <p class="text-muted mb-0">
                            Live figures across every posted subscription invoice.
                        </p>
                    </div>
                    <field name="currency_id" invisible="1"/>

                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <div class="o_sub_kpi">
                            <div class="o_sub_kpi_label">Active Subscriptions</div>
                            <div class="o_sub_kpi_value">
                                <field name="active_subscription_count" nolabel="1"/>
                            </div>
                            <div class="o_sub_kpi_hint">Currently billing</div>
                        </div>

                        <div class="o_sub_kpi o_sub_kpi_teal">
                            <div class="o_sub_kpi_label">Total Revenue</div>
                            <div class="o_sub_kpi_value">
                                <field name="total_revenue" nolabel="1" widget="monetary"/>
                            </div>
                            <div class="o_sub_kpi_hint">Paid invoices</div>
                        </div>

                        <div class="o_sub_kpi o_sub_kpi_amber">
                            <div class="o_sub_kpi_label">Outstanding</div>
                            <div class="o_sub_kpi_value">
                                <field name="outstanding_amount" nolabel="1" widget="monetary"/>
                            </div>
                            <div class="o_sub_kpi_hint">Awaiting payment</div>
                        </div>

                        <div class="o_sub_kpi o_sub_kpi_red">
                            <div class="o_sub_kpi_label">Overdue Invoices</div>
                            <div class="o_sub_kpi_value">
                                <field name="overdue_count" nolabel="1"/>
                            </div>
                            <div class="o_sub_kpi_hint">Past their due date</div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_subscription_dashboard_open" model="ir.actions.server">
        <field name="name">Dashboard</field>
        <field name="model_id" ref="model_subscription_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>

</odoo>
