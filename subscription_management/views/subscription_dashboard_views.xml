<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_subscription_dashboard_form" model="ir.ui.view">
        <field name="name">subscription.dashboard.form</field>
        <field name="model">subscription.dashboard</field>
        <field name="arch" type="xml">
            <form string="Subscription Dashboard" create="false" edit="false">
                <header>
                    <button name="action_refresh" string="Refresh" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Subscription Overview</h1>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group string="Subscriptions">
                            <field name="active_subscription_count"/>
                        </group>
                        <group string="Invoicing">
                            <field name="total_revenue" widget="monetary"/>
                            <field name="outstanding_amount" widget="monetary"/>
                            <field name="overdue_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_subscription_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">subscription.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="view_id" ref="view_subscription_dashboard_form"/>
    </record>

</odoo>
