<?xml version="1.0" encoding="utf-8"?>
<odoo>
<xpath expr="//header" position="inside">
    <button name="action_post" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
    <button name="action_invoice_sent" string="Send &amp; Print" type="object" class="btn-secondary" invisible="state == 'draft'"/>
    <button name="button_draft" string="Reset to Draft" type="object" invisible="state not in ('posted', 'cancel')"/>
</xpath>

    <!-- Invoice List View with Status Badges -->
    <record id="view_subscription_invoice_tree" model="ir.ui.view">
        <field name="name">account.move.subscription.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Subscription Invoices" decoration-danger="payment_state != 'paid' and invoice_date_due &lt; current_date" decoration-success="payment_state == 'paid'" decoration-warning="payment_state != 'paid' and invoice_date_due &gt;= current_date">
                <field name="name"/>
                <field name="partner_id" string="Customer"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due"/>
                <field name="amount_total" widget="monetary"/>
                <field name="payment_state" widget="badge" decoration-success="payment_state == 'paid'" decoration-danger="payment_state != 'paid' and invoice_date_due &lt; current_date" decoration-warning="payment_state != 'paid'"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Invoice Form Extension for Payment Logging -->
    <record id="view_subscription_invoice_form_inherit" model="ir.ui.view">
        <field name="name">account.move.subscription.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_register_subscription_payment" 
                        string="Record Payment" 
                        type="object" 
                        class="btn-primary" 
                        invisible="payment_state == 'paid'"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Payment Recording details" invisible="move_type != 'out_invoice'">
                    <group>
                        <field name="payment_method" required="payment_state != 'paid'"/>
                        <field name="payment_date"/>
                    </group>
                    <group>
                        <field name="payment_note" placeholder="Transaction ID, reference notes..."/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Search View with Overdue / Outstanding Filters -->
    <record id="view_subscription_invoice_search" model="ir.ui.view">
        <field name="name">account.move.subscription.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Search Subscription Invoices">
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Overdue Invoices" name="overdue" domain="[('payment_state', '!=', 'paid'), ('invoice_date_due', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Outstanding (Unpaid)" name="outstanding" domain="[('payment_state', '!=', 'paid')]"/>
                <filter string="Paid Invoices" name="paid" domain="[('payment_state', '=', 'paid')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by': 'payment_state'}"/>
                    <filter string="Customer" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Invoices Menu -->
    <record id="action_subscription_invoices" model="ir.actions.act_window">
        <field name="name">Invoices &amp; Payments</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_outstanding': 1}</field>
        <field name="search_view_id" ref="view_subscription_invoice_search"/>
    </record>
</odoo>
