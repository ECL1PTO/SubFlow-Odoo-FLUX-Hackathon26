<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_plan_list" model="ir.ui.view">
        <field name="name">subscription.plan.list</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <list string="Subscription Plans">
                <field name="name"/>
                <field name="billing_period"/>
                <field name="price"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="min_quantity"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="auto_close"/>
                <field name="allow_close_early"/>
                <field name="allow_pause"/>
                <field name="allow_renew"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <header>
                    <button name="toggle_active" type="object" string="Archive / Unarchive" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Monthly Business Plan"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Pricing &amp; Billing">
                            <field name="billing_period"/>
                            <field name="billing_interval"/>
                            <field name="price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="min_quantity"/>
                            <field name="quotation_validity_days"/>
                        </group>
                        <group string="Availability &amp; Rules">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="auto_close"/>
                            <field name="allow_close_early"/>
                            <field name="allow_pause"/>
                            <field name="allow_renew"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">subscription.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>